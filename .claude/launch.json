{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "maratang",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123",
        "--directory",
        "src"
      ],
      "port": 8123,
      "autoPort": false
    },
    {
      "name": "maratang-selfserve",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/dev/serve.py"
      ],
      "port": 8124,
      "autoPort": true
    },
    {
      "name": "maratang-release",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8131",
        "--directory",
        "dist"
      ],
      "port": 8131,
      "autoPort": false
    }
  ]
}
